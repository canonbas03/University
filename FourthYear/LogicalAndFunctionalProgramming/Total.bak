#| ; UPR. 5
   ; zad. 1
   (define (factoriel x)
   (cond
   ((= x 1)1)
   (else (* x (factoriel (- x 1))))
     )
     )
   
   ; zad. 2
   (define (countNum x)
   (cond
   ((= (quotient x 10) 0)1)
   (else (+ 1 (countNum (quotient x 10))))
     )
     )
   
   ; zad. 3
   (define (hasSeven num)
   (cond
   ((= num 0) "Not found 7")
   ((= (remainder num 10) 7) "Found 7")
   (else (hasSeven(quotient num 10)))
     )
     )
   
   ;zad. 4
   (define (progression n)
   (cond
   ((= n 1) 1)
    ((= (remainder n 3) 1) (* n (progression(- n 3))))
   (else (progression(- n 1)))
    )
     )
   
   ; zad. 5
   '(1 3 5 8)
   '((7 8) 2 3)
   (list (list 7 8) 2 3)
   
   ; zad. 6
   (car '(1 2 3 4))
   
   ; zad. 7
   (cdr '(1 2 3 4))
   
   ; zad. 8
   (cadr '(1 2 3 4))
   
   ; zad. 9
   (define (sumList lst)
   (cond
   ((null? lst) 0)
   (else (+ (car lst) (sumList (cdr lst))))
     )
  ) |#

