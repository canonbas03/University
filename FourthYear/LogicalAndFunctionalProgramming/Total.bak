#| ; UPR. 3
   ; zad. 1
   (define (findX x)
   (cond
     ((> x 5) (- (* 10 x) (+ (* 5 x) 5)))
   (else (- 100 (* 20 x) (* 15 x)))
      ))
   
   ; zad. 2
   (define (inRange x)
   (cond
   ((and (>= x 5) (<= x 10)) 'Yes)
   (else 'No)))
   
   ; zad. 3
   (define (koreni a b c)
   (define D (- (* b b) (* 4 a c)))
     (cond
   ((> D 0) '2_korena)
   ((= D 0) '1_koren)
   (else '0)
   ))
   
   ; zad. 4
   (define (xIn x)
   (cond
   ((or (and (> x 1) (< x 6)) (and (> x 16) (< x 21))) 'Yes)
   (else 'No)
     )
     )
   
   ; zad. 5
   (define (findX2 x)
   (cond
   ((> x 2) (- (* x x) (+ x 4)))
   ((and (<= 1 x) (<= x 2)) (/ 1 x))
   (else 0)))
   
   ; zad. 6
   (define (zad6 a b)
   (cond
   ((= a b) a)
   ((< a b) (* 2 a))
   (else (* 2 b))))
   
   ; zad. 7
   (define (talk str)
     (cond
   ((string=? str "Hi") "Hi, how are you")
   ((string=? str "How are you?") "Fine, thank you!")
   (else "I’m waiting!")
    )) |#
